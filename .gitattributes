# 1. Default: Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# 2. Source Code & Web Assets (Always LF)
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.svg           text eol=lf

# 3. Documentation & Configuration (Always LF)
*.md            text eol=lf diff=markdown
*.yml           text eol=lf
*.yaml          text eol=lf
.gitignore      text eol=lf
.prettierrc*    text eol=lf
.eslintrc*      text eol=lf

# 4. Binary Files (Never modify or convert line endings)
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.mp3           binary
*.mp4           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.pdf           binary

# 5. GitHub Linguist & Diff optimizations
package-lock.json   linguist-generated=true
