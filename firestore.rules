rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidMovie() {
      let data = request.resource.data;
      return data.uid == request.auth.uid &&
             data.id != null &&
             data.title is string &&
             data.title.size() > 0 &&
             data.watched_at is timestamp;
    }

    function isValidAlbum() {
      let data = request.resource.data;
      return data.uid == request.auth.uid &&
             data.name is string &&
             data.name.size() > 0 &&
             data.movieDocIds is list;
    }

    function isValidShare() {
      let data = request.resource.data;
      return data.isEnabled is bool &&
             (!('movies' in data) || data.movies is list);
    }

    function isValidUser() {
      let data = request.resource.data;
      return !('previouslyRecommendedTitles' in data) ||
             data.previouslyRecommendedTitles is list;
    }

    function isValidPushSubscription(userId) {
      let data = request.resource.data;
      return data.userId == userId &&
             data.endpoint is string &&
             data.endpoint.size() > 0 &&
             data.keys is map;
    }

    // Movies
    match /movies/{movieId} {
      allow read, delete: if isSignedIn() && isOwner(resource.data.uid);
      allow create: if isSignedIn() && isValidMovie();
      allow update: if isSignedIn() && isOwner(resource.data.uid) && isValidMovie();
    }

    // Albums
    match /albums/{albumId} {
      allow read, delete: if isSignedIn() && isOwner(resource.data.uid);
      allow create: if isSignedIn() && isValidAlbum();
      allow update: if isSignedIn() && isOwner(resource.data.uid) && isValidAlbum();
    }

    // Public shares - read public if enabled, write only owner
    match /public_shares/{userId} {
      allow read: if resource.data.isEnabled == true || (isSignedIn() && isOwner(userId));
      allow create, update: if isSignedIn() && isOwner(userId) && isValidShare();
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Users - stores preferences like previously recommended titles
    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create, update: if isSignedIn() && isOwner(userId) && isValidUser();
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Push Subscriptions
    match /push_subscriptions/{userId} {
      allow read, delete: if isSignedIn() && isOwner(userId);
      allow create, update: if isSignedIn() && isOwner(userId) && isValidPushSubscription(userId);
    }
  }
}
